# Postgres. On Vercel use the *pooled* Neon connection string — serverless
# functions open connections fast and a direct one runs out.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional. Without it the judge and the rubric drafter fall back to offline
# stubs, which the UI labels as not real rather than passing them off.
ANTHROPIC_API_KEY=

# Optional overrides.
# GR_PG_MAX=4
# GR_DRAFT_MODEL=claude-opus-5
