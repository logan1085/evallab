# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real key here.

# The one model key. Every model call goes through OpenRouter: the panel (one
# model family per seat), scenario writing, panel writing, rubric drafting and
# the judge. Without it the whole loop still runs against the deterministic
# simulation, which every surface labels as simulated rather than passing off
# as judgment.
OPENROUTER_API_KEY=

# Postgres. On Vercel use the *pooled* Neon connection string: serverless
# functions open connections fast and a direct one runs out. Unset means
# in-memory PGlite, which is not durable.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional overrides.
# GR_PG_MAX=4
# GR_CREATOR_PIN=anthropic-frontier-1
# Repin a seat without a code change when /api/health reports a pin unlisted.
# The value is an id from https://openrouter.ai/api/v1/models; keys follow the
# pin ids in server/pins.ts (mistral-small-1 -> GR_PIN_MISTRAL_SMALL_1).
# GR_PIN_MISTRAL_SMALL_1=mistralai/mistral-small-3.2-24b-instruct
# GR_ROUND_COST_CEILING_CREDITS=2
# GR_DAILY_COST_CEILING_CREDITS=20
